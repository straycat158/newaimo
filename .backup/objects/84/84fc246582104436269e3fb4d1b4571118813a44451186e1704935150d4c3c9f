@import "tailwindcss";

@theme {
  --font-sans: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  --font-serif: var(--font-serif), ui-serif, Georgia, serif;
}

:root {
  color-scheme: light;
  --md-primary: #6750a4;
  --md-primary-container: #eaddff;
  --md-on-primary-container: #21005d;
  --md-surface: #fffbff;
  --md-surface-container: #f3edf7;
  --md-outline: #e7e0ec;
  --md-text: #1d1b20;
  --md-muted: #625b71;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px;
  background: var(--md-surface);
}

body {
  min-width: 320px;
  background:
    radial-gradient(circle at 12% -8%, rgba(234, 221, 255, 0.72), transparent 28rem),
    radial-gradient(circle at 88% 4%, rgba(208, 188, 255, 0.30), transparent 30rem),
    var(--md-surface);
}

::selection {
  background: var(--md-primary);
  color: white;
}

.md3-hero-bg {
  background:
    radial-gradient(circle at 18% 8%, rgba(234, 221, 255, 0.95), transparent 26rem),
    radial-gradient(circle at 82% 18%, rgba(208, 188, 255, 0.42), transparent 24rem),
    linear-gradient(180deg, rgba(255, 251, 255, 0), rgba(255, 251, 255, 0.92));
}

.md3-card {
  position: relative;
  isolation: isolate;
  box-shadow:
    0 1px 2px rgba(29, 27, 32, 0.08),
    0 16px 44px rgba(103, 80, 164, 0.10);
  transition:
    transform 260ms cubic-bezier(0.2, 0, 0, 1),
    box-shadow 260ms cubic-bezier(0.2, 0, 0, 1);
}

.md3-card::before {
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  pointer-events: none;
  content: '';
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0) 46%),
    linear-gradient(315deg, rgba(103, 80, 164, 0.055), rgba(103, 80, 164, 0) 40%);
}

.md3-card:hover {
  box-shadow:
    0 2px 6px rgba(29, 27, 32, 0.08),
    0 22px 58px rgba(103, 80, 164, 0.14);
}

.shine-button {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.shine-button::after {
  position: absolute;
  top: -110%;
  left: -45%;
  width: 34%;
  height: 320%;
  pointer-events: none;
  content: '';
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.48), transparent);
  transform: rotate(24deg);
  transition: left 700ms cubic-bezier(0.2, 0, 0, 1);
}

.shine-button:hover::after {
  left: 120%;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
