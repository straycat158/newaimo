@import "tailwindcss";

@theme {
  --font-sans: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  --font-serif: var(--font-serif), ui-serif, Georgia, serif;
}

:root {
  color-scheme: light;
  --page-bg: #f7f6f2;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px;
  background: var(--page-bg);
}

body {
  min-width: 320px;
  background:
    radial-gradient(circle at 8% 4%, rgba(255, 255, 255, 0.95), transparent 28rem),
    radial-gradient(circle at 92% 18%, rgba(0, 0, 0, 0.045), transparent 32rem),
    var(--page-bg);
}

::selection {
  background: #18181b;
  color: #fff;
}

.surface-card {
  position: relative;
  isolation: isolate;
}

.surface-card::before {
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  pointer-events: none;
  content: '';
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), transparent 48%);
  opacity: 0.72;
}

.hero-panel::after {
  position: absolute;
  right: -12%;
  bottom: -28%;
  width: 26rem;
  height: 26rem;
  border-radius: 9999px;
  pointer-events: none;
  content: '';
  background: rgba(255, 255, 255, 0.1);
  filter: blur(70px);
}

.soft-grid {
  background-image:
    linear-gradient(rgba(0, 0, 0, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 0, 0, 0.025) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: linear-gradient(to bottom, black, transparent);
}

.shine-button {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.shine-button::after {
  position: absolute;
  top: -100%;
  left: -45%;
  width: 34%;
  height: 300%;
  pointer-events: none;
  content: '';
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  transform: rotate(24deg);
  transition: left 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.shine-button:hover::after {
  left: 120%;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
