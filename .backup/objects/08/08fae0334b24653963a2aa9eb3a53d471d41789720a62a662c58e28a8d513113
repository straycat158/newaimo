@import "tailwindcss";

@theme {
  --font-sans: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  --font-serif: var(--font-serif), ui-serif, Georgia, serif;
}

:root {
  color-scheme: light;
  --md-sys-color-primary: #6750a4;
  --md-sys-color-on-primary: #ffffff;
  --md-sys-color-primary-container: #eaddff;
  --md-sys-color-on-primary-container: #21005d;
  --md-sys-color-secondary-container: #e8def8;
  --md-sys-color-surface: #fffbfe;
  --md-sys-color-surface-container: #f3edf7;
  --md-sys-color-surface-container-high: #ece6f0;
  --md-sys-color-outline: #cac4d0;
  --md-sys-color-on-surface: #1d1b20;
  --md-sys-color-on-surface-variant: #49454f;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px;
  background: var(--md-sys-color-surface);
}

body {
  min-width: 320px;
  background:
    radial-gradient(circle at 8% 0%, rgba(234, 221, 255, 0.9), transparent 28rem),
    radial-gradient(circle at 92% 10%, rgba(255, 216, 228, 0.75), transparent 30rem),
    radial-gradient(circle at 50% 40%, rgba(208, 188, 255, 0.24), transparent 38rem),
    var(--md-sys-color-surface);
}

::selection {
  background: var(--md-sys-color-primary);
  color: var(--md-sys-color-on-primary);
}

.md3-bg {
  background:
    radial-gradient(circle at 12% 18%, rgba(234, 221, 255, 0.95), transparent 24rem),
    radial-gradient(circle at 88% 10%, rgba(255, 216, 228, 0.72), transparent 25rem),
    radial-gradient(circle at 70% 80%, rgba(216, 226, 255, 0.72), transparent 24rem),
    linear-gradient(180deg, rgba(255, 251, 254, 0), rgba(255, 251, 254, 0.92));
}

.md3-surface {
  position: relative;
  isolation: isolate;
  box-shadow: 0 1px 2px rgba(29, 27, 32, 0.08), 0 18px 48px rgba(103, 80, 164, 0.10);
  transition:
    transform 320ms cubic-bezier(0.2, 0, 0, 1),
    box-shadow 320ms cubic-bezier(0.2, 0, 0, 1),
    background-color 320ms cubic-bezier(0.2, 0, 0, 1);
}

.md3-surface::before {
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  pointer-events: none;
  content: '';
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0) 48%),
    linear-gradient(315deg, rgba(103, 80, 164, 0.08), rgba(103, 80, 164, 0) 38%);
}

.md3-surface:hover {
  box-shadow: 0 2px 6px rgba(29, 27, 32, 0.08), 0 26px 70px rgba(103, 80, 164, 0.16);
}

.shine-button {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.shine-button::after {
  position: absolute;
  top: -100%;
  left: -45%;
  width: 34%;
  height: 300%;
  pointer-events: none;
  content: '';
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  transform: rotate(24deg);
  transition: left 700ms cubic-bezier(0.2, 0, 0, 1);
}

.shine-button:hover::after {
  left: 120%;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
